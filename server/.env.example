# =====================================================================
# VERIDIC payments — environment
# ---------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit the real .env.
# Every value here is server-side only — none of it is ever sent to a
# browser. The browser only ever receives a short-lived, single-order
# "payment session id" for the checkout it's currently doing, not a
# reusable credential.
#
# With NOTHING set, the server still runs: payments are simulated and
# the SMS/email are printed to the console. Add keys to go live.
# =====================================================================

PORT=8123

# --------------------------- Admin console ---------------------------
# Protects /admin.html — the private page showing every customer's real
# name, email, phone, license key and payment status.
#
# Generate the hash (never store the plain password anywhere):
#     cd server
#     node scripts/hash-admin-password.mjs
# then paste the printed line below.
#
# With this unset, the admin page is DISABLED entirely — the API refuses
# every login attempt and all data routes return 401. Failing closed is
# deliberate: a missing password must never mean "no password required".
ADMIN_PASSWORD_HASH=

# How long an admin stays signed in before having to re-enter the
# password. The session cookie is HttpOnly + SameSite=Strict, and is
# Secure automatically whenever PUBLIC_URL is https or NODE_ENV=production.
ADMIN_SESSION_TTL_HOURS=12

# Public origin. Used to build the return_url and notify_url (webhook)
# Cashfree is given when an order is created.
PUBLIC_URL=http://localhost:8123

# ISO 4217, lowercase. Cashfree is India-first; INR is the default and
# most reliably supported currency.
CURRENCY=inr

DB_PATH=./orders.db

# Allow the simulated payment path even when Cashfree IS configured.
# Set to false in production so nobody can mint a free "paid" order.
ALLOW_DEMO_PAYMENTS=true


# --------------------------- Cashfree ---------------------------------
# cashfree.com → sign up → Dashboard → Developers → API Keys
#
# Sandbox/test credentials are available right after signup — no KYC or
# business registration needed to start testing. KYC is only required to
# switch CASHFREE_ENV to "production" and accept real money.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# "sandbox" (default, safe) or "production" (real money). Cashfree issues
# separate credentials for each — there's no reliable way to tell them
# apart just by looking at the key, so this is set explicitly rather than
# guessed from the key string.
CASHFREE_ENV=sandbox

# Webhook setup (optional but recommended for production):
#   Dashboard → Developers → Webhooks → Add Webhook
#     URL: https://your-domain/api/payments/webhook
#     Events: PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK,
#             PAYMENT_USER_DROPPED_WEBHOOK
#
# No separate secret to configure — Cashfree signs webhooks with the same
# CASHFREE_SECRET_KEY above, so there's nothing extra to copy in here.
#
# For LOCAL webhook testing, Cashfree needs a public HTTPS URL to reach
# your machine — use a tunnel (`ngrok http 8123`) and register the ngrok
# URL as the webhook endpoint. This is NOT required to test payments end
# to end, though: the reconcile-on-return call (in payments.js) makes its
# own authenticated request to Cashfree's API the moment checkout closes,
# which works on localhost with zero tunnel setup. The webhook is the
# extra safety net for a buyer who closes the tab before that call runs.


# --------------------------- Twilio (SMS) ----------------------------
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Either a purchased number in E.164...
TWILIO_FROM_NUMBER=+15551234567
# ...or a Messaging Service SID (takes precedence if both are set).
TWILIO_MESSAGING_SERVICE_SID=

# Trial accounts can ONLY send to numbers you have verified in the
# Twilio console. Verify your own mobile before testing.


# --------------------------- Resend (email) --------------------------
# resend.com → API Keys
RESEND_API_KEY=

# Until you verify your own domain, Resend only allows its shared
# sender and only delivers to your own signup address.
EMAIL_FROM=VERIDIC <onboarding@resend.dev>
EMAIL_REPLY_TO=
